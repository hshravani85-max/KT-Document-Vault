# ==============================================================================
# KHANNA TRAVELS - KT VAULT V3
# Off-Site Backup Configuration: Azure Immutable Blob Storage (WORM Immutability)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Azure Immutable Blob Storage must have Time-Based Retention or Legal Hold enabled.
# - Locked time-based retention policy prevents modification and deletion until expiration.
# - Do NOT commit active keys or connection strings to source control.
# ==============================================================================

KT_OFFSITE_STORAGE_PROVIDER=azure

# Azure Storage Account Name
AZURE_STORAGE_ACCOUNT=ktvaultbackupsprod

# Azure Blob Container Name (Must have immutability policy configured)
AZURE_STORAGE_CONTAINER=immutable-vault-backups

# Authentication Option A: Storage Account Access Key (Managed Identity or SAS preferred)
AZURE_STORAGE_KEY=SAMPLE_AZURE_STORAGE_ACCOUNT_KEY_PLACEHOLDER

# Authentication Option B: Full Connection String (Alternative to account key)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ktvaultbackupsprod;AccountKey=...;EndpointSuffix=core.windows.net

# Authentication Option C: Time-limited Shared Access Signature (SAS) Token
# AZURE_STORAGE_SAS_TOKEN=?sv=2024-05-04&ss=b&srt=co&sp=rwlacx&se=...

# Immutability Policy Type: time_based or legal_hold
AZURE_IMMUTABILITY_POLICY=time_based

# Retention duration in days (Khanna Travels compliance: 90 days minimum)
AZURE_RETENTION_DAYS=90
