# ==============================================================================
# KHANNA TRAVELS - KT VAULT V3
# Off-Site Backup Configuration: AWS S3 with Object Lock (WORM Immutability)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Offsite backups MUST be written to an S3 bucket with Object Lock enabled at creation.
# - Retention mode must be COMPLIANCE (neither root nor IAM can bypass or delete).
# - Do NOT commit active credentials to source control.
# ==============================================================================

KT_OFFSITE_STORAGE_PROVIDER=s3

# AWS S3 Bucket Name (Object Lock must be enabled during bucket creation)
AWS_S3_BUCKET=kt-vault-backups-immutable

# AWS Region where bucket resides (e.g. ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# Dedicated IAM User / Role with s3:PutObject and s3:GetObject only (No s3:DeleteObject)
AWS_ACCESS_KEY_ID=AKIA_SAMPLE_PLACEHOLDER_KEY
AWS_SECRET_ACCESS_KEY=SAMPLE_SECRET_ACCESS_KEY_DO_NOT_STORE_PLAINTEXT

# S3 Object Lock Mode: COMPLIANCE or GOVERNANCE (COMPLIANCE strongly recommended for WORM)
AWS_S3_OBJECT_LOCK_MODE=COMPLIANCE

# Retention duration in days (Khanna Travels compliance: 90 days minimum, 2555 days / 7 years maximum)
AWS_S3_RETENTION_DAYS=90

# Optional: Custom endpoint for S3-compatible compliant on-prem storage (e.g. MinIO, Cloudian)
# AWS_S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
